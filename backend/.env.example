# IANA timezone (e.g. America/Chicago), used anywhere the guide/DVR needs to
# reason about "today" (recording-rule expansion, the guide grid's date
# headers).
TIMEZONE=UTC

# Origin(s) the frontend runs on, for CORS. Comma-separated if you need more
# than one (e.g. a kiosk on localhost plus a phone/desktop browser on the
# LAN): CORS_ORIGIN=http://localhost:5173,http://192.168.1.50:3000
#
# This default (5173) is the local `npm run dev` / Vite port — it's NOT used
# by docker-compose, which sets CORS_ORIGIN itself (port 3000, matching its
# frontend service) directly in docker-compose.yml/.prod.yml, overriding
# whatever's in this file. Only edit this value for local (non-Docker) dev.
CORS_ORIGIN=http://localhost:5173

# Flags for the device/session cookies (app/auth.py). Defaults suit a
# same-host, HTTP-friendly LAN deployment. If frontend and backend are
# deployed on genuinely different hosts, cross-site cookies require
# COOKIE_SAMESITE=none + COOKIE_SECURE=true, which in turn requires real TLS
# — override both once a reverse proxy terminates it.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Root logger level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# --- Paths below are normally left at their defaults for local dev and only
# --- overridden by docker-compose.yml to point into a mounted volume.

# Where the SQLite database lives. Defaults to backend/storage.db.
# DB_PATH=

# Symmetric key used to encrypt secret settings values (Schedules Direct
# password, HDHomeRun DVR key, etc.) at rest. Defaults to backend/secret.key
# — losing this file strands every encrypted secret it protected.
# SECRET_KEY_PATH=

# Generated closed-caption WebVTT and scrub-bar thumbnail sprites for
# completed recordings. Defaults to backend/hdhomerun_media_cache.
# HDHOMERUN_MEDIA_CACHE_DIR=

# Where recorded MPEG-TS files are written by the self-hosted ("builtin")
# DVR engine. Defaults to backend/recordings — typically pointed at a NAS
# mount or a large disk, since OTA stream-copy runs roughly 2-4 GB/hour.
# RECORDINGS_DIR=
